# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/attendx
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/attendx
MONGODB_URI=mongodb://localhost:27017/attendx

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use long random strings in production (e.g. openssl rand -hex 64)
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-refresh-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── WebAuthn (biometric auth) ─────────────────────────────────────────────────
# In production: set to your actual domain (no https://)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave blank in dev — reset codes are printed to console instead
# Gmail:    SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
# Brevo:    SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AttendX <noreply@attendx.com>

# ── Cloudinary (avatar uploads) ───────────────────────────────────────────────
# Leave blank in dev — avatars saved to local uploads/avatars/ folder instead
# Get credentials: https://console.cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
